#!/usr/bin/env bash
set -euo pipefail

readonly LEFTHOOK_VERSION="2.1.10"
readonly LEFTHOOK_BIN="$HOME/.local/bin/lefthook"
readonly REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

download_archive=""
staged_binary=""
cleanup() {
  rm -f -- "$download_archive" "$staged_binary"
}
trap cleanup EXIT

run_step() {
  local label="$1"
  shift
  local started_at="$SECONDS"

  printf '==> %s\n' "$label"
  "$@"
  printf '<== %s (%ss)\n' "$label" "$((SECONDS - started_at))"
}

lefthook_is_installed() {
  [[ -x "$LEFTHOOK_BIN" ]] || return 1
  "$LEFTHOOK_BIN" version 2>/dev/null | grep -Fq "$LEFTHOOK_VERSION"
}

install_lefthook() {
  local architecture archive_checksum archive_url
  case "$(uname -m)" in
    x86_64)
      architecture="x86_64"
      archive_checksum="0b14162a0bb2f0c64ae0759f6102f6e19c4d00981666a8ac73d4f5a6878ada4f"
      ;;
    aarch64 | arm64)
      architecture="aarch64"
      archive_checksum="6380a6ad6dd484466fd69bd83f24491d6ec27dc0b84e837be025620f7c4e11e3"
      ;;
    *)
      printf 'Unsupported orb architecture: %s\n' "$(uname -m)" >&2
      return 1
      ;;
  esac

  if lefthook_is_installed; then
    printf 'Lefthook %s is already installed\n' "$LEFTHOOK_VERSION"
    return
  fi

  archive_url="https://github.com/evilmartians/lefthook/releases/download/v${LEFTHOOK_VERSION}/lefthook_${LEFTHOOK_VERSION}_Linux_${architecture}.gz"
  install -d "$(dirname "$LEFTHOOK_BIN")"
  download_archive="$(mktemp)"
  staged_binary="$(mktemp "$HOME/.local/bin/.lefthook.XXXXXX")"

  curl --fail --silent --show-error --location \
    --connect-timeout 10 --max-time 120 --retry 3 --retry-all-errors --retry-delay 2 --retry-max-time 180 \
    --speed-limit 1024 --speed-time 30 \
    "$archive_url" --output "$download_archive"
  printf '%s  %s\n' "$archive_checksum" "$download_archive" | sha256sum --check --status
  gzip -dc "$download_archive" >"$staged_binary"
  chmod 755 "$staged_binary"
  mv -- "$staged_binary" "$LEFTHOOK_BIN"
  staged_binary=""
  printf 'Installed Lefthook %s\n' "$LEFTHOOK_VERSION"
}

install_git_hooks() {
  local hooks_dir
  hooks_dir="$(git rev-parse --path-format=absolute --git-common-dir)/hooks"
  git config --local core.hooksPath "$hooks_dir"
  "$LEFTHOOK_BIN" install --force
}

cd -- "$REPO_ROOT"
printf '[orb-setup] repository: %s\n' "$REPO_ROOT"
run_step "Installing Lefthook" install_lefthook
run_step "Installing commit hooks" install_git_hooks
