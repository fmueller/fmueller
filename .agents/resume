#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd -- "$repo_root"

started_at="$(date +%s)"
printf '[orb-resume] no services or credentials need reconnecting; repository hooks are installed during setup.\n'
printf '[orb-resume] complete in %ss\n' "$(( $(date +%s) - started_at ))"
